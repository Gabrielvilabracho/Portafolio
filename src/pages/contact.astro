---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import ContactForm from '../presentation/components/ui/ContactForm.astro';
---
<BaseLayout
  title="Contact — Gabriel Vilabracho"
  description="Get in touch — I reply within a day."
  bodyClass="!bg-brand-grey-800 page-contact"
>
  <!--
    Fixed sentinel at y=0 with height = nav height.
    The IntersectionObserver in Navbar clips its zone to exactly the navbar height,
    so this element is always detected as intersecting → navbar stays dark on this page.
  -->
  <div
    data-navbar-theme="dark"
    aria-hidden="true"
    style="position: fixed; top: 0; left: 0; width: 100%; height: var(--layout-nav-height); pointer-events: none; z-index: -1;"
  ></div>

  <!--
    Container fills the viewport (minus navbar).
    The inner div is the vertical-rail host and centers content.
  -->
  <div
    class="container"
    style="min-height: calc(100vh - var(--layout-nav-height)); display: flex; flex-direction: column;"
  >
    <div
      style="
        flex: 1;
        display: flex;
        align-items: center;
        border-left: 1px solid var(--brand-grey-700);
        border-right: 1px solid var(--brand-grey-700);
      "
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 w-full">

        <!-- Left: identity + contact info -->
        <div
          class="flex flex-col gap-8 lg:border-r"
          style="padding: var(--brand-scale-1200) var(--brand-scale-1000); border-color: var(--brand-grey-700);"
        >
          <h1
            class="uppercase font-normal text-white"
            style="font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em; line-height: 1;"
          >
            Contact me
          </h1>

          <p class="bracket-badge" style="color: var(--brand-grey-500);">
            <span>Contacts</span>
          </p>

          <!-- Social icon row -->
          <div class="flex items-center gap-3">

            <!-- Email -->
            <a
              href="mailto:gvilabracho@gmail.com"
              class="social-icon-link"
              aria-label="Email"
            >
              <img src="/envelope.svg" alt="Email" width="20" height="20" class="social-icon-img" />
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/gabriel-vila-bracho"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="LinkedIn"
            >
              <img src="/linkedin.svg" alt="LinkedIn" width="20" height="20" class="social-icon-img" />
            </a>

            <!-- Telegram -->
            <a
              href="https://t.me/gabvila"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Telegram"
            >
              <img src="/telegram.svg" alt="Telegram" width="20" height="20" class="telegram-icon-img" />
            </a>

          </div>
        </div>

        <!-- Right: subtext + form -->
        <div
          class="flex flex-col justify-center gap-8"
          style="padding: var(--brand-scale-1200) var(--brand-scale-1000);"
        >
          <p style="color: var(--brand-grey-400); font-size: var(--type-paragraph-lg-size); max-width: 24em;">
            Drop me a line — I'll get back within a day.
          </p>
          <ContactForm />
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Adapt footer rail borders to match the dark contact page */
  .page-contact footer .section-pad {
    border-color: var(--brand-grey-700);
  }
  .page-contact footer p {
    color: var(--brand-grey-600);
  }

  /* Social icon containers — square bordered cells, borders merge on row */
  .social-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5em;
    height: 3.5em;
    border: 1px solid var(--brand-grey-700);
    clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px), 0 12px);
    color: var(--brand-grey-400);
    transition: color 0.2s, border-color 0.2s;
    position: relative;
    z-index: 0;
  }
  .social-icon-link:hover {
    color: var(--brand-orange-500);
    border-color: var(--brand-orange-500);
    z-index: 1;
  }

  .telegram-icon-img,
  .social-icon-img {
    filter: invert(1) brightness(0.7) contrast(1.2);
    transition: filter 0.2s;
  }

  .social-icon-link:hover .telegram-icon-img,
  .social-icon-link:hover .social-icon-img {
    filter: invert(44%) sepia(98%) saturate(1200%) hue-rotate(345deg) brightness(100%) contrast(100%);
  }
</style>
