---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import { getProjectsUseCase } from '../utils/di';
import HeroCrosses from '../presentation/components/sections/HeroCrosses.astro';
import SectionsGrid from '../presentation/components/sections/SectionsGrid.astro';
import ProjectsGrid from '../presentation/components/sections/ProjectsGrid.astro';
import CasesGrid from '../presentation/components/sections/CasesGrid.astro';
import Logbook from '../presentation/components/sections/Logbook.astro';
import ContactCta from '../presentation/components/sections/ContactCta.astro';

const allProjects = await getProjectsUseCase.execute();
const projects = allProjects.filter((project) => project.type === 'project');
const studyCases = allProjects
  .filter((project) => project.type === 'case')
  .sort((a, b) => (a.order ?? Number.MAX_SAFE_INTEGER) - (b.order ?? Number.MAX_SAFE_INTEGER));
---
<BaseLayout
  title="Gabriel Vilabracho — AI Engineer"
  description="AI Engineer applying artificial intelligence to help companies improve performance and reduce operating time."
>
  <HeroCrosses />
  <SectionsGrid />
  <ProjectsGrid projects={projects} />
  <CasesGrid cases={studyCases} />
  <Logbook />
  <ContactCta />
</BaseLayout>
