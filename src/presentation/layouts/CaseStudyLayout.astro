---
import {
  getCaseStudyThemeStyle,
  type CaseStudyTheme,
} from '../themes/caseStudyThemes';

export interface Props {
  title: string;
  summary?: string;
  theme?: CaseStudyTheme;
}

const { title, summary, theme } = Astro.props;
const themeStyle = theme ? getCaseStudyThemeStyle(theme) : undefined;
---

<section
  class="case-study-layout"
  data-case-study-layout
  data-case-theme={theme?.id}
  style={themeStyle}
>
  <article class="case-study-content" data-case-study-content>
    <header class="case-study-header">
      <p class="case-study-kicker">Case study</p>
      <h1>{title}</h1>
      {summary && <p class="case-study-summary">{summary}</p>}
    </header>

    <slot />
  </article>
</section>

<style>
  .case-study-layout {
    display: grid;
    grid-template-columns: minmax(var(--brand-scale-1100), 1fr) minmax(0, 42rem) minmax(var(--brand-scale-1100), 1fr);
    padding-block: clamp(var(--brand-scale-1400), 14vw, 14rem);
  }

  .case-study-layout[data-case-theme] {
    background-color: var(--case-surface);
    color: var(--case-text);
  }

  .case-study-layout[data-case-theme='document-intelligence'] {
    border-block: 1px solid var(--case-border);
    font-family: var(--brand-font-family);
  }

  .case-study-content {
    grid-column: 2;
    min-width: 0;
  }

  .case-study-header {
    margin-bottom: clamp(var(--brand-scale-1300), 10vw, 10rem);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-header {
    border-bottom: 1px solid var(--case-border);
    padding-bottom: var(--brand-scale-900);
  }

  .case-study-kicker {
    color: var(--brand-grey-500);
    font-size: var(--type-paragraph-xsm-size);
    letter-spacing: 0.16em;
    margin-bottom: var(--brand-scale-700);
    text-transform: uppercase;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-kicker {
    color: var(--case-accent);
  }

  .case-study-content h1 {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.98;
    margin: 0;
    text-transform: uppercase;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content h1 {
    color: var(--case-heading-primary);
  }

  .case-study-summary {
    color: var(--brand-grey-600);
    font-size: var(--type-paragraph-lg-size);
    line-height: 1.55;
    margin: var(--brand-scale-900) 0 0;
    max-width: 36rem;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-summary {
    color: var(--case-text);
  }

  .case-study-content :global(h2) {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.12;
    margin: clamp(var(--brand-scale-1300), 8vw, 8rem) 0 var(--brand-scale-700);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(h2) {
    color: var(--case-heading-primary);
  }

  .case-study-content :global(p),
  .case-study-content :global(li) {
    font-size: var(--type-paragraph-lg-size);
    line-height: 1.65;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(p),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(li) {
    color: var(--case-text);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(h3),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(h4),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(h5) {
    color: var(--case-heading-secondary);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(table) {
    border: 1px solid var(--case-border);
    border-collapse: collapse;
    inline-size: 100%;
    line-height: 1.5;
    table-layout: fixed;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td) {
    border: 1px solid var(--case-border);
    overflow-wrap: anywhere;
    padding: var(--brand-scale-700);
    vertical-align: middle;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th) {
    border-bottom-width: 2px;
    color: var(--case-heading-primary);
    text-align: center;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th:nth-child(1)),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(1)) {
    inline-size: 24%;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th:nth-child(2)),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(2)) {
    inline-size: 30%;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th:nth-child(3)),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(3)) {
    inline-size: 46%;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(1)),
  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(2)) {
    text-align: center;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td:nth-child(3)) {
    text-align: left;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram) {
    background: var(--case-surface);
    border: 1px solid var(--case-border);
    inline-size: min(82rem, calc(100vw - (2 * var(--brand-scale-1100))));
    left: 50%;
    margin-block: var(--brand-scale-1100) clamp(var(--brand-scale-1300), 8vw, 8rem);
    margin-inline: 0;
    position: relative;
    transform: translateX(-50%);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram__viewport) {
    border-bottom: 1px solid var(--case-border);
    max-inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram__viewport:focus-visible) {
    outline: 3px solid var(--case-accent);
    outline-offset: 3px;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram__frame) {
    block-size: clamp(38rem, 64vw, 52rem);
    border: 0;
    display: block;
    inline-size: 100%;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram figcaption) {
    color: var(--case-text);
    font-size: var(--type-paragraph-sm-size);
    line-height: 1.55;
    margin: 0;
    padding: var(--brand-scale-700) var(--brand-scale-800);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram figcaption a) {
    color: var(--case-heading-primary);
    display: inline-block;
    font-weight: 600;
    margin-inline-start: 0.35em;
    text-decoration-color: var(--case-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram figcaption a:focus-visible) {
    outline: 3px solid var(--case-accent);
    outline-offset: 3px;
  }

  .case-study-content :global(p),
  .case-study-content :global(ul),
  .case-study-content :global(ol) {
    margin: 0 0 var(--brand-scale-800);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-intro-callout) {
    background-color: var(--case-heading-secondary);
    color: var(--brand-grey-100);
    margin-inline: clamp(var(--brand-scale-300), 2.5vw, var(--brand-scale-700));
    padding: clamp(var(--brand-scale-800), 5vw, var(--brand-scale-1100));
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-intro-callout__title) {
    color: var(--brand-grey-100);
    margin: 0 0 var(--brand-scale-700);
  }

  .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-intro-callout__body) {
    color: var(--brand-grey-100);
    letter-spacing: 0.01em;
    margin: 0;
    max-inline-size: 70ch;
  }

  .case-study-content :global(img),
  .case-study-content :global(video) {
    margin-block: clamp(var(--brand-scale-1100), 8vw, 8rem);
    width: 100%;
  }

  @media (max-width: 719px) {
    .case-study-layout {
      display: block;
      padding: var(--brand-scale-1300) var(--brand-scale-1100);
    }

    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(table) {
      font-size: var(--type-paragraph-xsm-size);
    }

    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(th),
    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(td) {
      padding: calc(var(--brand-scale-700) / 2);
    }

    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram) {
      inline-size: 100%;
      left: auto;
      margin-block: var(--brand-scale-1000) var(--brand-scale-1300);
      transform: none;
    }

    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram__frame) {
      block-size: 60rem;
      min-inline-size: 112rem;
    }

    .case-study-layout[data-case-theme='document-intelligence'] .case-study-content :global(.case-study-diagram figcaption) {
      padding: var(--brand-scale-700);
    }
  }
</style>
