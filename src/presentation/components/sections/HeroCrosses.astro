---
import { withBase } from '../../../utils/withBase';

/**
 * Hero in two stacked bands:
 * 1. Dark visual band — cross pattern contained within the page margins.
 * 2. Light band — bracket label left, GVB wordmark right.
 */
---
<section class="bg-white">
  <div class="container">
    <div
      class="relative overflow-hidden border-l border-r border-b border-brand-grey-200"
      style="min-height: 20vh;"
    >
      <img
        src={withBase('/imagenes/cross-background.svg')}
        alt=""
        class="absolute inset-0 w-full h-full"
       style="max-width: none; opacity: 0.5; transform: scale(1);"
      />
    </div>
  </div>
</section>

<div class="container">
  <div
    class="section-pad bg-dark-surface border-brand-grey-200 dark:border-brand-grey-700 flex flex-wrap items-start justify-between gap-8 relative overflow-hidden"
    data-navbar-theme="dark"
  >
    <img
      src={withBase('/imagenes/cross-background.svg')}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full pointer-events-none"
      style="max-width: none; opacity: 0.15; transform: scale(0.9);"
    />
    <div class="relative z-10 flex flex-col items-start gap-4">
      <span class="marker-reveal">
        <img
          src={withBase('/imagenes/gabriel-vila-bracho-transparent.svg')}
          alt="Gabriel Vilabracho"
          style="height: clamp(21rem, 18vw, 12rem); width: auto;"
        />
      </span>

      <span class="marker-reveal marker-reveal--delayed" style="margin-left: 5rem;">
        <p class="bracket-badge" style="color: #f5f5f0;">
          <span>AI Engineering · Portfolio</span>
        </p>
      </span>
    </div>

  </div>
</div>

<!-- .marker-reveal styling and arming live in globals.css and the reveal
     coordinator script in BaseLayout.astro. -->
