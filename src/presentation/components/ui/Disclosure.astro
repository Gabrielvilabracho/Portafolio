---
export interface Props {
  title: string;
  defaultOpen?: boolean;
  readable?: boolean;
}

const { title, defaultOpen = false, readable = false } = Astro.props;
---

<details class:list={['disclosure', { 'disclosure--readable': readable }]} open={defaultOpen || undefined}>
  <summary class="disclosure__trigger">
    <span class="disclosure__indicator" aria-hidden="true"></span>
    <span>{title}</span>
  </summary>

  <div class="disclosure__content">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    border: 1px dashed var(--brand-grey-300);
    transition: border-style 160ms ease, border-color 160ms ease;
  }

  .disclosure[open] {
    border-style: solid;
    border-color: var(--brand-grey-500);
  }

  .disclosure__trigger {
    display: flex;
    align-items: center;
    gap: var(--brand-scale-300);
    padding: var(--brand-scale-400) var(--brand-scale-500);
    color: inherit;
    cursor: pointer;
    font-size: var(--type-paragraph-sm-size);
    font-weight: var(--brand-weight-medium);
    line-height: 1.3;
    list-style: none;
  }

  .disclosure__trigger::-webkit-details-marker {
    display: none;
  }

  .disclosure__trigger:focus-visible {
    outline: 2px solid var(--brand-orange-500);
    outline-offset: -2px;
  }

  .disclosure__indicator {
    width: 0.75em;
    height: 0.75em;
    flex: 0 0 auto;
    border: 1px solid var(--brand-orange-500);
    background-color: transparent;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .disclosure[open] .disclosure__indicator {
    background-color: var(--brand-orange-500);
    transform: scale(0.8);
  }

  .disclosure__content {
    padding: 0 var(--brand-scale-500) var(--brand-scale-500);
    color: var(--brand-grey-600);
    font-size: var(--type-paragraph-sm-size);
    line-height: 1.6;
  }

  .disclosure--readable > .disclosure__trigger,
  .disclosure--readable > .disclosure__content {
    font-size: max(14px, 1rem);
  }

  :global(.dark) .disclosure {
    border-color: var(--brand-grey-700);
  }

  :global(.dark) .disclosure[open] {
    border-color: var(--brand-grey-400);
  }

  :global(.dark) .disclosure__content {
    color: var(--brand-grey-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure,
    .disclosure__indicator {
      transition: none;
    }
  }
</style>
