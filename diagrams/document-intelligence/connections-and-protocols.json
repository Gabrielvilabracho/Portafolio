      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "User traffic reaches the BFF over HTTPS with a Clerk session.",
        "JWT-authenticated REST enters the Go API before Temporal coordinates processing."
      ]
    },
    {
      "dot": "violet",
      "title": "Queue separation",
      "items": [
        "General and GPU processing use dedicated Temporal task queues.",
        "Layout / OCR work remains on its own task queue."
      ]
    },
    {
      "dot": "emerald",
      "title": "Model access",
      "items": [
        "FastAPI routes to Bedrock through LiteLLM and to vLLM / Qwen through an OpenAI-compatible API.",
